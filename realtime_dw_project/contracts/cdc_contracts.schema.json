{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdc_contracts.schema.json",
  "title": "Realtime DW CDC contracts",
  "type": "object",
  "required": ["contract_version", "compatibility_policy", "cross_table_consistency", "entities"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"type": "integer", "minimum": 1},
    "compatibility_policy": {"const": "backward_additive"},
    "cross_table_consistency": {"const": "eventual"},
    "description": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_table", "flink_source_table", "flink_sink_table", "topic", "primary_key", "delete_semantics", "fields"],
        "additionalProperties": false,
        "properties": {
          "source_table": {"type": "string", "minLength": 1},
          "flink_source_table": {"type": "string", "minLength": 1},
          "flink_sink_table": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "primary_key": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "delete_semantics": {"const": "kafka_tombstone"},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "flink_type", "nullable"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "flink_type": {"type": "string", "minLength": 1},
                "nullable": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
