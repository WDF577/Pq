# Local demo defaults. Copy to .env only when overriding values.
KAFKA_PORT=9092
KAFKA_PARTITIONS=3
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecommerce
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_LOADER_GROUP_ID=clickhouse_loader
CLICKHOUSE_LOADER_DLQ_TOPIC=clickhouse_loader_dlq
CLICKHOUSE_LOADER_AUTO_OFFSET_RESET=earliest
CLICKHOUSE_LOADER_BATCH_SIZE=500
CLICKHOUSE_LOADER_FLUSH_INTERVAL=2.0
# Increment only if Kafka offsets are reset while the ClickHouse volume is kept.
CLICKHOUSE_LOADER_VERSION_EPOCH=128
CLICKHOUSE_LOADER_METRICS_PORT=9410
# Freshness cannot distinguish a legitimate quiet period from an upstream outage.
# Enable stale-data alerts only for an environment with an agreed traffic/SLA window.
PIPELINE_FRESHNESS_MONITOR_ENABLED=false
PIPELINE_BUSINESS_TIMEZONE=Asia/Shanghai
PIPELINE_FRESHNESS_INTERVAL_SECONDS=15
PIPELINE_FRESHNESS_STALE_AFTER_SECONDS=300
PIPELINE_FRESHNESS_QUERY_TIMEOUT_SECONDS=5
PIPELINE_FRESHNESS_METRICS_PORT=9420
FLINK_UI_PORT=8081
FLINK_TASK_SLOTS=16
FLINK_JM_METRICS_PORT=9249
FLINK_TM_METRICS_PORT=9250
KAFKA_EXPORTER_PORT=9308
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
