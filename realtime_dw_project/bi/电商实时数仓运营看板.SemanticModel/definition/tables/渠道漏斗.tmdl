/// 一分钟窗口的渠道阶段人数，一行代表一个窗口内的一个渠道。
table 渠道漏斗
	lineageTag: 50d42474-8e93-4006-a43a-70ba0cea5262

	/// 当前时间筛选范围内渠道漏斗表的最新一分钟窗口。
	measure 最新渠道窗口 = CALCULATE(MAX('渠道漏斗'[窗口开始]), REMOVEFILTERS('渠道漏斗'[渠道]))
		formatString: yyyy-MM-dd HH:mm
		isHidden
		displayFolder: 窗口指标
		lineageTag: 968bf618-14c5-44b5-8764-705708096645

	/// 当前筛选范围最新一分钟窗口内，当前渠道的浏览人数。
	measure 渠道最新窗口浏览人数 =
			VAR _latest = [最新渠道窗口]
			RETURN
			    CALCULATE(SUM('渠道漏斗'[浏览人数]), KEEPFILTERS('渠道漏斗'[窗口开始] = _latest))
		formatString: #,##0
		displayFolder: 渠道指标
		lineageTag: 8d3c503e-695f-4918-be93-f2fbdeb49be8

	/// 当前筛选范围最新一分钟窗口内，当前渠道的加购人数。
	measure 渠道最新窗口加购人数 =
			VAR _latest = [最新渠道窗口]
			RETURN
			    CALCULATE(SUM('渠道漏斗'[加购人数]), KEEPFILTERS('渠道漏斗'[窗口开始] = _latest))
		formatString: #,##0
		displayFolder: 渠道指标
		lineageTag: 47e2bc86-976e-4165-b6a1-8997fbe5a1a2

	/// 当前筛选范围最新一分钟窗口内，当前渠道的下单人数。
	measure 渠道最新窗口下单人数 =
			VAR _latest = [最新渠道窗口]
			RETURN
			    CALCULATE(SUM('渠道漏斗'[下单人数]), KEEPFILTERS('渠道漏斗'[窗口开始] = _latest))
		formatString: #,##0
		displayFolder: 渠道指标
		lineageTag: 4db3c4f6-1fc2-43da-8722-241898cdd902

	/// 当前筛选范围最新一分钟窗口内，当前渠道的支付人数。
	measure 渠道最新窗口支付人数 =
			VAR _latest = [最新渠道窗口]
			RETURN
			    CALCULATE(SUM('渠道漏斗'[支付人数]), KEEPFILTERS('渠道漏斗'[窗口开始] = _latest))
		formatString: #,##0
		displayFolder: 渠道指标
		lineageTag: 89354de6-f8d0-44eb-bf66-751609304f3e

	column 窗口开始
		dataType: dateTime
		isHidden
		isNullable: false
		formatString: yyyy-MM-dd HH:mm
		lineageTag: a55b2b11-6c82-4829-a348-c7edfc6f286c
		summarizeBy: none
		sourceColumn: window_start

	column 窗口结束
		dataType: dateTime
		isHidden
		isNullable: false
		formatString: yyyy-MM-dd HH:mm
		lineageTag: ed34c5c1-9dc8-411e-bfc3-9a9239345635
		summarizeBy: none
		sourceColumn: window_end

	/// 用户行为来源渠道。
	column 渠道
		dataType: string
		lineageTag: 1e2a993f-69d6-4acf-8cfe-62c1a787723f
		summarizeBy: none
		sourceColumn: channel

	column 浏览人数
		dataType: int64
		isHidden
		lineageTag: 39011e52-6d84-46ec-84da-bc9ba4f22eb0
		summarizeBy: none
		sourceColumn: view_users

	column 加购人数
		dataType: int64
		isHidden
		lineageTag: 1a8738fb-c67e-4266-9943-6de7aaf6b1f8
		summarizeBy: none
		sourceColumn: cart_users

	column 下单人数
		dataType: int64
		isHidden
		lineageTag: 11e946df-8e4e-402a-9680-e8dd00955a3d
		summarizeBy: none
		sourceColumn: order_users

	column 支付人数
		dataType: int64
		isHidden
		lineageTag: 417c7d67-9759-4ef2-828e-7ab8990690e0
		summarizeBy: none
		sourceColumn: pay_users

	partition 渠道漏斗 = m
		mode: import
		source =
				let
				    ConnectionString = "Driver={ClickHouse ODBC Driver (Unicode)};Url=http://" & #"ClickHouse 主机" & ":" & #"ClickHouse 端口" & ";Database=" & #"ClickHouse 数据库" & ";Timeout=30;",
				    Source = Odbc.Query(ConnectionString, "SELECT window_start, window_end, channel, view_users, cart_users, order_users, pay_users FROM ads_channel_funnel FINAL")
				in
				    Source
